# ==============================================================================
# NAVEX Trading AI - Environment Variables Template
# ==============================================================================
# IMPORTANT: This project is a simulated paper-trading evaluation prototype.
# NEVER enter live exchange API keys, private trading keys, or account secrets.
# No private trading API keys are required or supported.
# ==============================================================================

# Application Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# LLM Provider Configuration
# Options: "demo" (deterministic offline rule engine) | "openai" | "gemini" | "anthropic"
LLM_PROVIDER=demo
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# Optional API Keys (Only needed if LLM_PROVIDER is not "demo")
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Public data providers (optional; keys are server-side only)
# Crypto candles use Binance public REST by default and need no key.
MARKET_DATA_PROVIDER=binance
MARKET_DATA_TIMEOUT_SECONDS=4

# NEWS_PROVIDER=auto tries CryptoPanic, then NewsAPI, then the safe local fallback.
NEWS_PROVIDER=auto
CRYPTOPANIC_API_KEY=
NEWSAPI_KEY=

# Optional stock/forex providers for a future non-crypto instrument adapter.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=

# Deterministic Risk Engine Parameters
INITIAL_CAPITAL=100000.0
MAX_RISK_PER_TRADE_PCT=0.01     # 1% max account risk ($1,000 on $100k equity)
MIN_RISK_REWARD_RATIO=1.5        # 1.5:1 minimum reward-to-risk ratio
MAX_LEVERAGE=2.0                # 2x maximum notional exposure
MIN_STOP_DISTANCE_PCT=0.003     # 0.3% minimum stop distance from entry
MAX_STOP_DISTANCE_PCT=0.08      # 8.0% maximum stop distance from entry

# Simulated Execution Parameters
TAKER_FEE_RATE=0.0005           # 0.05% taker fee
DEFAULT_SLIPPAGE_RATE=0.0002    # 0.02% base slippage
DEFAULT_ASSET=BTC/USDT
